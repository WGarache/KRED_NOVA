# Copie este archivo como .env y complete los valores (NUNCA lo suba a GitHub)
DJANGO_SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=cobros.sudominio.com
EMPRESA_NOMBRE=MicroFinanciera Ejemplo S.A.

# PostgreSQL (si no se define DB_NAME se usa SQLite)
DB_NAME=erp_cobros
DB_USER=erp
DB_PASSWORD=clave-segura
DB_HOST=localhost

# Gmail: use una "contraseña de aplicación", no su contraseña normal
EMAIL_HOST_USER=cobros.sudominio@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
